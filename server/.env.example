# Copia este archivo como server/.env y ajusta los valores.

# OBLIGATORIO. Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3001
DB_PATH=data/ruta-segura.db
# Pon false si la base está en un disco de red (por ejemplo, /home en Azure App Service).
SQLITE_WAL=true
# true carga 10 reportes ficticios marcados como ejemplo; al arrancar con otro valor, se borran.
DATOS_DEMO=false
REFRESH_DIAS=7
BCRYPT_ROUNDS=12

# Pon false solo para probar en HTTP fuera de localhost. Nunca en producción.
COOKIE_SECURE=true

# Número de proxies delante de la API. En Render o Railway suele ser 1.
TRUST_PROXY=0

# Correos de moderadoras, separados por comas. Se aplican al arrancar el servidor:
# registra la cuenta primero y después agrega su correo aquí.
MODERADORAS=

# Nominatim exige identificar la aplicación. Agrega un correo de contacto del equipo.
NOMINATIM_USER_AGENT=RutaSegura/1.0 (contacto@ejemplo.org)
